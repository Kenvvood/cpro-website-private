# Production .env 模板 (cpro-website)
# 复制到 .env.production, 替换 <...> 占位符

# === 数据库 (SQLite, 默认本地) ===
# ECS 上用本地 SQLite 即可 (无 RDS 需求)
DATABASE_URL="file:./prisma/prod.db"

# === NextAuth 公网 URL ===
NEXTAUTH_URL="https://www.cprotrading.com"
NEXTAUTH_SECRET="<openssl rand -base64 32>"

# === CDN (可选) ===
# NEXT_PUBLIC_CDN_URL="https://cdn.cprotrading.com"

# === L3 编译产物同步 (Mavis 阶段 1) ===
# 1914 brand + 9328 OpenSource 已 import 到 dev.db
# 生产时跑: npx prisma migrate deploy + node prisma/seed_assets.js
