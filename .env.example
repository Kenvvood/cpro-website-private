# cpro-website .env.example
# task057 Phase 9 真实链上验证 - 4 项必备环境变量占位符
# ⚠️ 复制本文件为 .env, 填入真实值, 严禁 commit .env

# ============================================================================
# 数据库 (Prisma 7)
# ============================================================================
DATABASE_URL="file:./prisma/dev.db"

# ============================================================================
# NextAuth v4
# ============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ============================================================================
# task057 Phase 9 - USDT 真实链上验证 (P0 上线前置)
# ============================================================================
# 关闭 Mock · 启用真实验证（生产环境必须 false）
CHAIN_VERIFIER_MOCK=false

# TronGrid API Key · https://www.trongrid.io/ 注册获取 · 免费 5 req/s
TRONGRID_API_KEY=

# BscScan API Key · https://bscscan.com/apis 注册获取 · 免费 5 req/s
BSCSCAN_API_KEY=

# TRC20 收款钱包地址 · 波场 T 开头 34 字符
USDT_TRC20_RECEIVER=

# BEP20 收款钱包地址 · 以太坊格式 0x 开头 42 字符
USDT_BSC_RECEIVER=

# ============================================================================
# 兼容旧名 (建议与上方 RECEIVER 同步)
# ============================================================================
USDT_TRC20_WALLET=
USDT_BSC_WALLET=

# ============================================================================
# task063 - Upstash Redis (Serverless HTTP, 限流 + 验证码存储)
# 不配置 → fail-open 降级 (主流程不受影响, 仅失去限流与验证码持久化)
# ============================================================================
# Upstash 控制台: https://console.upstash.com/ · 免费 10K 请求/天
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================================
# v22.0 PATCH 17.7: DB 自动备份 → 阿里云 OSS
# 阿里云控制台 https://ram.console.aliyun.com/manage/ak 创建 AccessKey
# 权限: AliyunOSSFullAccess (OSS 全部权限)
# 建议 Bucket 命名: cprotrading-backup, 区域 cn-guangzhou, 存储类型 低频访问
# 生命周期: 自动删除 30 天前的 db/ 前缀对象
# ============================================================================
BACKUP_OSS_ACCESS_KEY_ID=
BACKUP_OSS_ACCESS_KEY_SECRET=
BACKUP_OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
BACKUP_OSS_BUCKET=cprotrading-backup
# BACKUP_LOCAL_DIR=/var/backups/cpro-website  # 本地保留路径 (默认)

# ============================================================================
# v22.0 PATCH 17.10: 监控告警 (CloudMonitor / 钉钉 / Sentry / ARMS)
# MONITOR_PROVIDER: sentry | self | arms
# 留空 → 默认 self (console + 本地日志)
# ============================================================================
MONITOR_PROVIDER=self
# ARMS 前端监控 pid (从 ARMS 控制台 → 前端监控 → Web/H5 应用获取)
# NEXT_PUBLIC_ARMS_PID=
# SENTRY_DSN=https://...@sentry.io/... (PM 拍板启用 Sentry 后填)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ALERT_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=...
# 钉钉群机器人 → 安全设置 → 自定义关键词 "告警" / 加签
# ALERT_SMS_PHONES=13800138000,13900139000  # 阿里云 SMS 接收人 (待 SDK 集成)

# ============================================================================
# v22.0 BATCH 24: 邮件 (Resend HTTP API)
# Resend 控制台: https://resend.com/api-keys · 免费 3K 邮件/月 + 100/天
# 域名验证: https://resend.com/domains (加 cprotrading.com 域 + DKIM/SPF)
# 留空 → 邮件发送被跳过 (不影响主流程, 仅 dev 日志警告)
# ============================================================================
# Resend API key (re_xxx 开头)
RESEND_API_KEY=
# 发件人 (需域名验证后改 contact@cprotrading.com 之类)
EMAIL_FROM=CProTrading 城诺科技 <noreply@cprotrading.com>
# 用户回复邮件会到这
EMAIL_REPLY_TO=support@cprotrading.com